{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "project": ["*.js"]
    },
    "packages/build": {
      "entry": ["src/build.ts", "src/build-static.ts", "src/computeNodeModulesCacheKey.ts", "src/dev.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@lvce-editor/shared-process", "esbuild"]
    },
    "packages/e2e": {
      "entry": ["src/**/*.ts", "fixtures/**/main.js"],
      "project": ["src/**/*.ts", "fixtures/**/*.js"]
    },
    "packages/hover-worker": {
      "entry": ["src/hoverWorkerMain.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/memory": {
      "entry": ["src/measureMemory.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["playwright"]
    },
    "packages/server": {
      "entry": ["src/postinstall.js"],
      "project": ["src/**/*.js"],
      "ignoreDependencies": ["@lvce-editor/server"]
    }
  }
}
